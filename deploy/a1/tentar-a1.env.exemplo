# Modelo do tentar-a1.env (copie para tentar-a1.env e preencha). Nada secreto aqui: só identificadores da sua conta.
# A chave de API da Oracle fica em ~/.oci/ (permissão 600) e NUNCA neste arquivo.
COMPARTMENT_OCID=ocid1.compartment.oc1..PREENCHA
SUBNET_OCID=ocid1.subnet.oc1.PREENCHA
# Imagem: Canonical Ubuntu 24.04, aarch64 (a que o console mostra para o formato A1)
IMAGE_OCID=ocid1.image.oc1.PREENCHA
AVAILABILITY_DOMAIN=XXXX:SA-SAOPAULO-1-AD-1
# Limites do plano grátis (o script recusa passar de 2 / 12 / 200)
OCPUS=2
MEM_GB=12
DISK_GB=50
NOME=concord-voz
# SSH_PUB_FILE=/home/ubuntu/.ssh/chave_oracle.pub
