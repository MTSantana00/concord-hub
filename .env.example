# Copie para .env no servidor (nunca coloque o .env no repositório) e preencha.
# Gere segredos com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=production
SERVER_PORT=3001

# Assina o login das pessoas. Sem ele o servidor se recusa a iniciar em produção.
JWT_SECRET=

# Acesso só por convite (é o padrão em produção). Só use "false" se quiser cadastro aberto.
INVITE_ONLY=true
# Quantos convites cada pessoa pode ter no total (padrão 10)
INVITE_LIMIT=10
# Código secreto (12+ caracteres) para criar a PRIMEIRA conta, a sua. Só vale enquanto não existe nenhuma conta.
# Depois, entre uma vez em  https://SEU-SITE/convite/<este código>  e crie sua conta.
OWNER_SETUP_CODE=

# Onde ficam os dados (use um disco que não se perde ao reiniciar)
DATABASE_PATH=/var/lib/concord/concord.db
AUDIO_DIR=/var/lib/concord/audio
IMAGES_DIR=/var/lib/concord/images
# Backups automáticos do banco (1 por dia, guarda os 14 mais recentes)
BACKUP_DIR=/var/lib/concord/backups
# Quantos proxies (Caddy) ficam na frente do app; em produção o padrão é 1. Serve para os limites anti-spam verem o IP real
# TRUST_PROXY=1

# Servidor de mídia (LiveKit): voz, câmera e tela.
# LIVEKIT_URL é o endereço que o NAVEGADOR usa, com wss:// (ex.: wss://concord-media.duckdns.org).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voz própria + reserva (opcional). O servidor escolhe o LiveKit PRÓPRIO (principal) enquanto ele responder e usa o
# LiveKit Cloud (reserva) quando ele cair. As LIVEKIT_* acima continuam valendo como reserva. Sem MEDIA_PRIMARY_*,
# tudo funciona como antes (só a reserva). Para voltar atrás: apague as três MEDIA_PRIMARY_* e reinicie.
# MEDIA_PRIMARY_URL=wss://SEU-NOME.duckdns.org
# MEDIA_PRIMARY_KEY=
# MEDIA_PRIMARY_SECRET=
# (opcional: se quiser, a reserva pode usar estes nomes em vez de LIVEKIT_*)
# MEDIA_FALLBACK_URL=
# MEDIA_FALLBACK_KEY=
# MEDIA_FALLBACK_SECRET=

# Notificações com o app fechado (opcional). Gere o par de chaves UMA vez com:  npm run push-keys -w server
# Guarde a chave privada em segredo; trocar as chaves invalida as assinaturas já feitas.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@exemplo.com

# Limites do plano gratuito do LiveKit Cloud, para os avisos da administradora (0 desliga: use se hospedar o LiveKit você mesmo)
# LIVEKIT_MINUTES_LIMIT=5000
# LIVEKIT_GB_LIMIT=50

# Entrar com Google e GitHub (opcional; veja tasks/oauth-credenciais.md). Sem as credenciais os botões não aparecem.
# PUBLIC_URL=https://concord-hub.duckdns.org
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# E-mail (opcional): confirmar o e-mail no cadastro, "esqueci a senha" e e-mail de boas-vindas. Sem estas variáveis tudo isso
# fica desligado e o app funciona como antes. Qualquer SMTP serve; o Gmail é grátis (500 e-mails por dia) com uma "senha de app":
# conta Google > Segurança > Verificação em duas etapas ligada > Senhas de app. NUNCA use a senha normal da conta.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=senha-de-app-de-16-letras
# MAIL_FROM=Concord Hub <seu-email@gmail.com>
